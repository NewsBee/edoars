//   // userId    Int
//   typeId       BigInt
//   accessTypeId BigInt
//   createdAt    DateTime @default(now())

//   // User User @relation(fields: [userId], references: [id])
//   Type Type @relation(fields: [typeId], references: [id])

// }

// ──────────────────────────────────────────────────────────────────────────────
// 15) TEMPORARY FILE
// ──────────────────────────────────────────────────────────────────────────────
model TemporaryFile {
  id        Int      @id @default(autoincrement())
  folder    String
  filename  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────────────────────
// 16) SETTING
// ──────────────────────────────────────────────────────────────────────────────
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ──────────────────────────────────────────────────────────────────────────────
// 17) ACTIVITY SUBMISSION LOG
//     - Mencatat aktivitas user terhadap submission atau titleSubmission.
// ──────────────────────────────────────────────────────────────────────────────
model ActivitySubmissionLog {
  id                Int      @id @default(autoincrement())
  submissionId      BigInt?
  titleSubmissionId Int?
  userId            Int
  activity          String
  createdAt         DateTime @default(now())

  Submission      Submission?      @relation(fields: [submissionId], references: [id])
  TitleSubmission TitleSubmission? @relation(fields: [titleSubmissionId], references: [id])
  User            User             @relation(fields: [userId], references: [id])
}

// ──────────────────────────────────────────────────────────────────────────────
// 18) DISCUSSION
//     - Contoh diskusi sederhana (kadang bisa digantikan oleh DiscussionRoom di atas).
// ──────────────────────────────────────────────────────────────────────────────
model Discussion {
  id           Int      @id @default(autoincrement())
  submissionId BigInt
  senderId     Int
  message      String
  createdAt    DateTime @default(now())

  Submission Submission @relation(fields: [submissionId], references: [id])
  User       User       @relation(fields: [senderId], references: [id])
}

// ──────────────────────────────────────────────────────────────────────────────
// 19) GRADING
//     - Menyimpan penilaian dosen/verifikator terhadap Submission
//       (atau bisa pula diperluas agar mendukung TitleSubmission).
// ──────────────────────────────────────────────────────────────────────────────
model Grading {
  id            Int      @id @default(autoincrement())
  submissionId  BigInt
  verificatorId Int
  grade         Float
  comments      String?
  createdAt     DateTime @default(now())

  Submission Submission @relation(fields: [submissionId], references: [id])
  User       User       @relation(fields: [verificatorId], references: [id])
}

// model RequiredValue {
//   id                BigInt     @id @default(autoincrement())
//   name              String     @unique
//   key               String     @unique
//   note              String?    // Nullable
//   formatId          BigInt
//   format            Format    @relation(fields: [formatId], references: [id])
//   createdAt         DateTime   @default(now())
//   updatedAt         DateTime   @updatedAt

//   // Optional: If you want to reference this model in other places, you can add the relations here.
// }
model RequiredValue {
  id       BigInt  @id @default(autoincrement())
  name     String
  key      String  
  note     String?   @db.Text // Nullable and can be long text
  formatId BigInt
  bobot    Float?
  // type_id  BigInt?

  // type                    Type?                     @relation(fields: [type_id], references: [id])
  format                  Format                    @relation(fields: [formatId], references: [id], onDelete: Cascade)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  SubmissionRequiredValue SubmissionRequiredValue[]
}

model SubmissionRequiredValue {
  id              BigInt   @id @default(autoincrement()) // Primary key, Auto Increment
  value           String // Nilai penilaian yang diinput oleh dosen
  requiredValueId BigInt // Foreign Key yang mengarah ke tabel `RequiredValue`
  verificatorId   BigInt // Foreign Key yang mengarah ke tabel `Verificator`
  submissionId    BigInt // Foreign Key yang mengarah ke tabel `Submission`
  createdAt       DateTime @default(now()) // Timestamp ketika data dibuat
  updatedAt       DateTime @updatedAt // Timestamp otomatis diperbarui saat data diubah

  // Relasi ke tabel-tabel lain
  requiredValue RequiredValue @relation(fields: [requiredValueId], references: [id])
  verificator   Verificator   @relation(fields: [verificatorId], references: [id])
  submission    Submission    @relation(fields: [submissionId], references: [id])
}

enum VerificatorType {
  Pembimbing
  Penguji
  PembimbingAkademik
}

enum VerificatorStatus {
  pending
  approved
  rejected
}

enum SubmissionStatus {
  pending
  processed
  approved
  rejected
  repeated
}

model Verificator {
  id                BigInt            @id @default(autoincrement()) // Kunci utama
  titleSubmissionId Int?
  type              VerificatorType // Tipe Verificator (Pembimbing, Penguji, Pembimbing Akademik)
  status            VerificatorStatus @default(pending) // Status Verificator (Active/Inactive)
  createdAt         DateTime          @default(now()) // Waktu pembuatan
  updatedAt         DateTime          @updatedAt // Waktu pembaruan
  note              String?           @db.Text // Catatan tambahan
  totalScore        Float?            // Total nilai penilaian
  averageScore      Float?            // Rata-rata nilai penilaian
  // score             Float?             // Nilai penilaian
  // RELASI
  submissionId      BigInt? // Jika berhubungan dengan submission
  Submission        Submission?       @relation(fields: [submissionId], references: [id]) // Relasi dengan tabel submissions

  lecturerId              Int // Dosen yang terlibat sebagai Verificator
  TitleSubmission         TitleSubmission?          @relation(fields: [titleSubmissionId], references: [id])
  User                    User                      @relation(fields: [lecturerId], references: [id]) // Relasi dengan tabel User (Dosen)
  SubmissionRequiredValue SubmissionRequiredValue[]
}

model Announcement {
  id           BigInt   @id @default(autoincrement()) // Kunci utama
  description  String   @db.Text
  judul        String
  fileLampiran String?
  status       Boolean  @default(true)
  createdAt    DateTime @default(now()) // Waktu pembuatan
  updatedAt    DateTime @updatedAt // Waktu pembaruan
}
