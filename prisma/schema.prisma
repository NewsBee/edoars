generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
//  1) USER
//     - Menampung data pengguna (mahasiswa, dosen, admin, dsb.)
// ──────────────────────────────────────────────────────────────────────────────
model User {
  id                     Int       @id @default(autoincrement())
  external_user_id       Int?      @unique
  name                   String
  email                  String    @unique
  phone_number           String?
  nim                    String?   @unique
  password               String?
  nip                    String?   @unique
  role                   String // contoh: "mahasiswa", "dosen", "admin"
  nama_satker            String?
  id_satker              String?
  periode_masuk          String?
  google_drive_folder_id String?
  status                 String // "1" = aktif, "0" = nonaktif (atau gunakan enum/boolean)
  signature_image        String?
  profile_image          String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  last_login             DateTime?

  // RELASI KE ENTITAS LAIN
  Submissions         Submission[]
  Notifications       Notification[]
  Logs                ActivitySubmissionLog[]
  Discussions         Discussion[]
  Grading             Grading[]
  StudentPermissions  StudentTypeAccessPermission[]
  // TypePermissions     GetTypeAccessPermission[]
  AssignedLecturers   AssignedLecturer[]
  SkillGroupLecturers SkillGroupLecturer[]
  TitleSubmissions    TitleSubmission[] // relasi 1-N ke TitleSubmission
  DiscussionRooms     DiscussionRoom[]
  SentMessages        Message[]                     @relation("UserToMessage")
  Verificator         Verificator[]
  AuditLog            AuditLog[]
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  action    String
  timestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ──────────────────────────────────────────────────────────────────────────────
//  2) TITLE SUBMISSION
//     - Pengajuan judul penelitian/skripsi yang terpisah dari Submission utama.
// ──────────────────────────────────────────────────────────────────────────────
model TitleSubmission {
  id        Int      @id @default(autoincrement())
  userId    Int // Mahasiswa
  title     String
  topic     String?
  abstract  String?  @db.Text
  status    String   @default("Pending") // Pending, Approved, Rejected
  reason    String? // Alasan penolakan (jika Rejected)
  lirs      String?
  toefl     String?
  proposal  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // RELASI
  User              User                    @relation(fields: [userId], references: [id])
  assignedLecturers AssignedLecturer[] // Dosen pembimbing/penguji TitleSubmission
  Verificator       Verificator[]
  activityLogs      ActivitySubmissionLog[] // Log aktivitas
  // requiredFiles     SubmissionRequiredFile[] @relation(name: "SubmissionRequiredFileToTitleSubmission")
}

// ──────────────────────────────────────────────────────────────────────────────
//  3) SUBMISSION
//     - Pengajuan umum (misal: Proposal, Sidang, dsb.)
// ──────────────────────────────────────────────────────────────────────────────
// model Submission {
//   id             Int       @id @default(autoincrement())
//   userId         Int // Mahasiswa
//   typeId         Int // Tipe pengajuan (misal: Proposal, Sidang)
//   relatedTitleId Int? // Jika ingin mengaitkan ke TitleSubmission (opsional)
//   title          String
//   description    String?   @db.Text
//   status         String    @default("Pending")
//   jadwal         DateTime?
//   createdAt      DateTime  @default(now())
//   updatedAt      DateTime  @updatedAt

//   // RELASI
//   User                    User                      @relation(fields: [userId], references: [id])
//   Type                    Type                      @relation(fields: [typeId], references: [id])
//   RequiredFiles           SubmissionRequiredFile[]
//   Logs                    ActivitySubmissionLog[]
//   Discussions             Discussion[]
//   Grading                 Grading[]
//   AssignedLecturers       AssignedLecturer[]
//   DiscussionRoom          DiscussionRoom[]
//   SubmissionRequiredValue SubmissionRequiredValue[]
//   Verificator             Verificator[]
// }

model Submission {
  id                   BigInt           @id @default(autoincrement())
  typeId               BigInt
  userId               Int
  title                String
  description          String?          @db.Text
  status               SubmissionStatus? @default(pending)
  jadwal               DateTime? // Jadwal seminar
  requestJadwal        DateTime? // Jadwal seminar
  room                 String? // Ruang seminar
  recordUrl            String? // URL rekaman seminar/sidang
  grade                String? // Grade char dari penilaian pengajuan
  gradeDescription     String? // Deskripsi grade dari penilaian pengajuan
  score                String? // Total rata-rata dari penilaian pengajuan
  gradeStatus          String? // Status grading
  documentFormat       String? // URL download dokumen hasil penilaian
  academicYear         String? // Tahun akademik pengajuan
  amountOfSks          String? // Jumlah SKS mahasiswa
  ipkNow               String? // Indeks Prestasi Kumulatif mahasiswa
  isReadByTataUsaha    Boolean          @default(false) // Jika sudah atau belum dilihat staff bagian administrasi
  isReadyToBeProcessed Boolean          @default(false) // Pengajuan sudah siap diproses
  spotaSubmissionId    String? // ID untuk sistem SPOTA (jika relevan)
  semester             String? // Semester pengajuan dilakukan
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  skillGroupId         Int?
  SkillGroup           SkillGroup?      @relation(fields: [skillGroupId], references: [id], name: "SkillGroupToSubmissions")
  decision             Decision?        // Hasil keputusan
  recommendTitleChange String?          // Rekomendasi perubahan judul

  // RELASI
  User                    User                      @relation(fields: [userId], references: [id])
  Type                    Type                      @relation(fields: [typeId], references: [id])
  RequiredFiles           SubmissionRequiredFile[]
  Logs                    ActivitySubmissionLog[]
  Discussions             Discussion[]
  Grading                 Grading[]
  AssignedLecturers       AssignedLecturer[]
  DiscussionRoom          DiscussionRoom[]
  SubmissionRequiredValue SubmissionRequiredValue[]
  Verificator             Verificator[]
}

enum Decision {
  MenungguKeputusan
  DiterimaDenganPerbaikan
  Diterima
  Diulang
  Ditolak
}

// ──────────────────────────────────────────────────────────────────────────────
//  4) TYPE
//     - Jenis pengajuan (misal: "Proposal", "Sidang", dsb.)
// ──────────────────────────────────────────────────────────────────────────────
// model Type {
//   id          Int      @id @default(autoincrement())
//   name        String   @unique
//   slug        String   @unique
//   color       String
//   description String?
//   status      String   @default("active")
//   createdAt   DateTime @default(now())
//   updatedAt   DateTime @updatedAt

//   // Apakah ini "format utama" dsb. (menyadur istilah is_primary)
//   is_primary Boolean @default(false)
//   // Apakah tipe ini bisa diakses publik/semua mahasiswa tanpa setting manual
//   is_public  Boolean @default(false)

//   // RELASI
//   Submissions        Submission[]
//   RequiredFiles      RequiredFile[]
//   Formats            Format[]
//   StudentPermissions StudentTypeAccessPermission[]
//   TypePermissions    TypeAccessPermission[]
// }
model Type {
  id          BigInt   @id @default(autoincrement()) // Primary Key
  name        String   @unique // Nama tipe pengajuan
  slug        String   @unique // URL unik untuk tipe pengajuan
  color       String // Penanda warna untuk statistik
  description String? // Deskripsi penjelasan tipe pengajuan
  status      Status   @default(active) // Status aktif atau tidak (enum)
  createdAt   DateTime @default(now()) // Waktu dibuat
  updatedAt   DateTime @updatedAt // Waktu pembaruan otomatis

  // Relasi
  submissions           Submission[]
  // requiredFiles      RequiredFile[]
  formats               Format[]
  studentPermissions    StudentTypeAccessPermission[]
  typePermissions       GetTypeAccessPermission[]
  accessTypePermissions GetTypeAccessPermission[]     @relation("AccessTypeRelation")
  // RequiredValue      RequiredValue[]
}

// Enum untuk status
enum Status {
  active
  inactive
}

// ──────────────────────────────────────────────────────────────────────────────
//  5) APPROVAL LOG
//     - Mencatat aksi "Approved/Rejected" oleh Dosen/Admin (opsional).
// ──────────────────────────────────────────────────────────────────────────────
model ApprovalLog {
  id                Int      @id @default(autoincrement())
  userId            Int // ID yang memberi approval
  submissionId      Int? // Terkait Submission
  titleSubmissionId Int? // Terkait TitleSubmission
  action            String // "Approved" / "Rejected"
  reason            String?
  createdAt         DateTime @default(now())
}

// ──────────────────────────────────────────────────────────────────────────────
//  6) REQUIRED FILE
//     - Daftar file yang DIBUTUHKAN oleh Type tertentu.
// ──────────────────────────────────────────────────────────────────────────────
// model RequiredFile {
//   id              Int      @id @default(autoincrement())
//   typeId          Int
//   file_name       String
//   is_required     Boolean  @default(true)
//   allowed_formats String // contoh: "PDF, DOCX"
//   createdAt       DateTime @default(now())
//   updatedAt       DateTime @updatedAt

//   // RELASI
//   Type                    Type                     @relation(fields: [typeId], references: [id])
//   SubmissionRequiredFiles SubmissionRequiredFile[]
// }
model RequiredFile {
  id                   BigInt   @id @default(autoincrement())
  name                 String // Nama file yang harus diupload
  key                  String // Kode atau kata kunci unik untuk file
  note                 String? // Catatan tambahan (nullable)
  formatId             BigInt // Relasi ke format_id
  // typeId               BigInt
  isVerificatorCanEdit Boolean  @default(false) // Dapat diedit oleh verifikator
  isVerificatorCanView Boolean  @default(false) // Dapat dilihat oleh verifikator
  createdAt            DateTime @default(now()) // Waktu pembuatan
  updatedAt            DateTime @updatedAt // Waktu pembaruan

  // RELASI
  // Type                    Type                     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  Format                  Format                   @relation(fields: [formatId], references: [id], onDelete: Cascade) // Relasi ke format
  SubmissionRequiredFiles SubmissionRequiredFile[] // Relasi ke submission_required_files
}

// ──────────────────────────────────────────────────────────────────────────────
//  7) SUBMISSION REQUIRED FILE
//     - Berkas yang benar-benar diunggah oleh Mahasiswa di tiap pengajuan
//       (bisa Submission atau TitleSubmission).
// ──────────────────────────────────────────────────────────────────────────────
model SubmissionRequiredFile {
  id                Int      @id @default(autoincrement())
  titleSubmissionId Int?
  submissionId      BigInt?
  requiredFileId    BigInt
  file_url          String?
  status            String   @default("Pending")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // RELASI
  // TitleSubmission TitleSubmission? @relation(name: "SubmissionRequiredFileToTitleSubmission", fields: [titleSubmissionId], references: [id]) // Relasi opsional
  Submission   Submission?  @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  RequiredFile RequiredFile @relation(fields: [requiredFileId], references: [id])
}

// ──────────────────────────────────────────────────────────────────────────────
//  8) ASSIGNED LECTURER
//     - Menandakan dosen pembimbing/penguji yang ditugaskan untuk pengajuan
//       (bisa ke TitleSubmission atau Submission).
// Enum untuk role dosen
enum LecturerRole {
  Pembimbing1
  Pembimbing2
  Penguji1
  Penguji2
}

// ──────────────────────────────────────────────────────────────────────────────
model AssignedLecturer {
  id                Int      @id @default(autoincrement())
  titleSubmissionId Int?
  submissionId      BigInt?
  status            String   @default("aktif")
  lecturerId        Int // Dosen
  role              String // "Pembimbing 1", "Penguji", dsb.
  source            String? // "TitleSubmission" / "Submission" (opsional)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  // RELASI
  TitleSubmission TitleSubmission? @relation(fields: [titleSubmissionId], references: [id])
  Submission      Submission?      @relation(fields: [submissionId], references: [id])
  User            User             @relation(fields: [lecturerId], references: [id])
}

// ──────────────────────────────────────────────────────────────────────────────
//  9) FORMAT
//     - Opsi format dari Tipe Pengajuan (mirip sub-level).
// ──────────────────────────────────────────────────────────────────────────────
// model Format {
//   id                   Int       @id @default(autoincrement())
//   typeId               Int
//   name                 String
//   document_format      String?
//   is_primary           Boolean   @default(false)
//   is_schedule_required Boolean   @default(false)
//   createdAt            DateTime  @default(now())
//   updatedAt            DateTime  @updatedAt

//   // RELASI
//   Type Type @relation(fields: [typeId], references: [id])
// }
model Format {
  id                                 BigInt   @id @default(autoincrement())
  typeId                             BigInt
  name                               String
  document_format                    String?
  document_format_name               String?
  document_format_size               String?
  is_primary                         Boolean  @default(true)
  is_schedule_required               Boolean  @default(false) // sudah ada
  is_newtitle_submission             Boolean  @default(false) // pengajuan judul baru
  give_access_to_mahasiswa           Boolean  @default(false) // Bagikan hak akses ke semua mhs?
  if_pass_then_give_access_type_id   Int? // ID Tipe Pengajuan yang akan otomatis diizinkan jika lulus
  requires_pembimbing                Boolean  @default(false)
  requires_penguji                   Boolean  @default(false)
  requires_skill_group               Boolean  @default(false)
  requires_academic_advisor          Boolean  @default(false) // pembimbing akademik?
  next_submission_uses_current_verif Boolean  @default(false) // pengajuan selanjutnya otomatis pakai verifikator sekarang
  createdAt                          DateTime @default(now())
  updatedAt                          DateTime @updatedAt
  status                             String   @default("active")

  // RELASI
  requiredFiles  RequiredFile[]
  requiredValues RequiredValue[]
  getTypeAcces   GetTypeAccessPermission[]
  Type           Type                      @relation(fields: [typeId], references: [id], onDelete: Cascade)
}

// ──────────────────────────────────────────────────────────────────────────────
// 10) SKILL GROUP
//     - Kelompok keahlian (jika diperlukan).
// ──────────────────────────────────────────────────────────────────────────────
model SkillGroup {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  status    String   @default("aktif")

  Submissions Submission[]         @relation("SkillGroupToSubmissions")
  Lecturers   SkillGroupLecturer[]
}

model SkillGroupLecturer {
  id           Int      @id @default(autoincrement())
  position     String
  skillGroupId Int
  userId       Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  SkillGroup SkillGroup @relation(fields: [skillGroupId], references: [id])
  User       User       @relation(fields: [userId], references: [id])
}

// ──────────────────────────────────────────────────────────────────────────────
// 11) NOTIFICATION
//     - Menyimpan notifikasi untuk user.
// ──────────────────────────────────────────────────────────────────────────────
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  is_read   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  User User @relation(fields: [userId], references: [id])
}

// ──────────────────────────────────────────────────────────────────────────────
// 12) DISCUSSION ROOM, POINT, MESSAGE
//     - Untuk diskusi bimbingan, dsb. 
// ──────────────────────────────────────────────────────────────────────────────
model DiscussionRoom {
  id            Int      @id @default(autoincrement())
  submissionId  BigInt
  participantId Int
  role          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  Submission       Submission        @relation(fields: [submissionId], references: [id])
  User             User              @relation(fields: [participantId], references: [id])
  Messages         Message[]
  DiscussionPoints DiscussionPoint[]
}

model DiscussionPoint {
  id               Int      @id @default(autoincrement())
  discussionRoomId Int
  description      String?
  status           String   @default("Pending")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  DiscussionRoom DiscussionRoom @relation(fields: [discussionRoomId], references: [id])
  Messages       Message[]
}

model Message {
  id                Int      @id @default(autoincrement())
  discussionRoomId  Int
  discussionPointId Int?
  senderId          Int
  content           String
  fileUrl           String?
  messageType       String   @default("text")
  createdAt         DateTime @default(now())

  DiscussionRoom  DiscussionRoom   @relation(fields: [discussionRoomId], references: [id])
  DiscussionPoint DiscussionPoint? @relation(fields: [discussionPointId], references: [id])
  Sender          User             @relation(fields: [senderId], references: [id], name: "UserToMessage")
}

// ──────────────────────────────────────────────────────────────────────────────
// 13) STUDENT TYPE ACCESS PERMISSION
//     - Mahasiswa userId=... punya akses ke Tipe typeId=...
// ──────────────────────────────────────────────────────────────────────────────
model StudentTypeAccessPermission {
  id        Int      @id @default(autoincrement())
  userId    Int
  typeId    BigInt
  createdAt DateTime @default(now())

  User User @relation(fields: [userId], references: [id])
  Type Type @relation(fields: [typeId], references: [id])

  @@unique([userId, typeId])
}

// ──────────────────────────────────────────────────────────────────────────────
// 14) TYPE ACCESS PERMISSION
//     - Misal untuk Admin / Dosen (atau pihak tertentu) agar bisa mengelola Tipe.
// ──────────────────────────────────────────────────────────────────────────────

model GetTypeAccessPermission {
  id           BigInt   @id @default(autoincrement())
  typeId       BigInt
  accessTypeId BigInt
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  formatId     BigInt
  // type_id  BigInt?

  // type                    Type?                     @relation(fields: [type_id], references: [id])
  format Format @relation(fields: [formatId], references: [id], onDelete: Cascade)

  Type       Type @relation(fields: [typeId], references: [id])
  AccessType Type @relation("AccessTypeRelation", fields: [accessTypeId], references: [id])
}

